/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": "src/index.ts",
	"compatibility_date": "2026-02-28",
	"observability": {
		"enabled": true,
	},
	"compatibility_flags": ["nodejs_compat"],
	"env": {
		"dev": {
			"name": "stoozebot-dev",
			"d1_databases": [
				{
					"binding": "DB",
					"database_id": "dde31626-7ade-474b-9a58-c25f5c748b1d",
					"database_name": "stoozebot_dev",
					"migrations_dir": "./migrations",
					"remote": false,
				},
			],
			"durable_objects": {
				"bindings": [
					{
						"name": "BOT_THROTTLER",
						"class_name": "BotThrottler",
					}
				]
			},
			"migrations": [
				{
					"tag": "v1",
					"new_sqlite_classes": ["BotThrottler"]
				}
			]
		},
		"prod": {
			"name": "stoozebot",
			"d1_databases": [
				{
					"binding": "DB",
					"database_id": "b159e0b6-ba7e-4114-a86e-69e1d9e17b6b",
					"database_name": "stoozebot",
					"migrations_dir": "./migrations",
					"remote": false,
				},
			],
			"durable_objects": {
				"bindings": [
					{
						"name": "BOT_THROTTLER",
						"class_name": "BotThrottler"
					}
				]
			},
			"migrations": [
				{
					"tag": "v1",
					"new_sqlite_classes": ["BotThrottler"]
				}
			]
		},
	},
}